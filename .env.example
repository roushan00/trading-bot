# Application
APP_NAME=trading-bot
APP_ENV=development
DEBUG=true
PAPER_TRADING_MODE=true

# Database
DATABASE_URL=postgresql+asyncpg://trading_bot:trading_bot_dev@localhost:5432/trading_bot
DATABASE_URL_SYNC=postgresql://trading_bot:trading_bot_dev@localhost:5432/trading_bot

# Redis
REDIS_URL=redis://localhost:6379/0

# Angel One SmartAPI
SMARTAPI_API_KEY=your_api_key_here
SMARTAPI_CLIENT_ID=your_client_id_here
SMARTAPI_PASSWORD=your_password_here
SMARTAPI_TOTP_SECRET=your_totp_secret_here

# Risk Management
MAX_DAILY_LOSS_PCT=2.0
MAX_DRAWDOWN_PCT=10.0
MAX_POSITION_PCT=5.0
RISK_PER_TRADE_PCT=1.0
INITIAL_CAPITAL=100000

# Logging
LOG_LEVEL=INFO

# Email Alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_RECIPIENT=your_email@gmail.com
